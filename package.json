{
  "name": "depublius",
  "version": "1.0.0",
  "description": "Streaming author-identification demo on Cloudflare Workers",
  "type": "module",
  "license": "MIT",
  "author": "Carey Lening <carey.lening@gmail.com>",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply depublius --local",
    "db:migrate:remote": "wrangler d1 migrations apply depublius --remote",
    "db:export": "wrangler d1 export depublius --remote --output ./export.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20260502.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
